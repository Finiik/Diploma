rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user formula interaction counters — the collaborative-filtering
    // source (FIRESTORE_COLLECTIONS.userInteractions; one document per uid).
    //
    // Asymmetric on purpose: collaborative filtering must read *other*
    // users' interaction vectors — getAllInteractions() lists the whole
    // collection to build the neighbourhood — so any authenticated user
    // may read. The data is non-PII (an opaque Firebase uid mapped to
    // per-formula view/calculation/bookmark counts). Writes are
    // owner-locked: a user may only mutate the document at their own uid.
    match /userInteractions/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user saved formula ids (FIRESTORE_COLLECTIONS.bookmarks).
    // Fully private: nothing reads across users, so the owner is the only
    // principal allowed to read or write their own document.
    match /bookmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else (no other collection is used by the client).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
