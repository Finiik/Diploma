{
  "name": "science-recommender",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recommendation system for natural science students — formulas, theory, problems & calculator",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src"
  },
  "dependencies": {
    "firebase": "^11.4.0",
    "fuse.js": "^7.0.0",
    "i18next": "^24.2.2",
    "katex": "^0.16.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-katex": "^3.0.1",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  }
}
